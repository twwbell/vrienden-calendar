    {
      "id": "cf6a4dce-e2ce-4136-a014-f4b4d02a261d",
      "name": "Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2120,
        -120
      ],
      "parameters": {
        "jsCode": "// Last guardrail before the gist: a message that lost Botolas' sign-off or grew far too\n// long probably came from injected instructions in the calendar or sheet. Throwing leaves\n// the gist on yesterday's date, so the Shortcut sends nothing and the error workflow mails.\nconst message = String($json.output ?? '').trim();\nconst lastLine = message.split('\\n').pop().replace(/[*_~\\s]/g, '').toLowerCase();\n\nif (!lastLine.includes('jullie') || !lastLine.includes('botolas')) {\n  throw new Error('Message does not end with the Botolas sign-off:\\n\\n' + message);\n}\nif (message.length > 2500) {\n  throw new Error('Message is ' + message.length + ' characters, more than the 2500 allowed:\\n\\n' + message);\n}\n\nreturn [{ json: { date: $today.toISODate(), message } }];\n"
      }
    },
    {
      "id": "5394ce2e-a46b-427c-8acd-6f07e2e2a62c",
      "name": "No message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        2120,
        120
      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ JSON.stringify({ date: $today.toISODate(), message: \"\" }) }}",
        "options": {}
      }
    },
    {
      "id": "c172c8f1-c2e2-41cf-9c9b-3470856fe890",
      "name": "Write gist",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2360,
        0
      ],
      "parameters": {
        "method": "PATCH",
        "url": "=https://api.github.com/gists/{{ $('Config').first().json.gistId }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => {\n  const facts = $('Facts').first().json;\n  const files = {\n    [$('Config').first().json.gistFile]: { content: JSON.stringify({ date: $json.date, message: $json.message }, null, 2) },\n  };\n  if ($json.message) {\n    const history = [...facts.recentMessages, { date: $json.date, message: $json.message }].slice(-7);\n    files[facts.historyFile] = { content: JSON.stringify(history, null, 2) };\n  }\n  return JSON.stringify({ files });\n})() }}",
        "options": {}
      },
      "credentials": {
        "githubApi": {
          "id": "",
          "name": "githubApi"
        }
      }
    }
