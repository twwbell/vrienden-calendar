    {
      "id": "2a9dd0b4-a00f-4fdf-8699-4e8a22e8615d",
      "name": "Facts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "jsCode": "// Turns the raw calendar events and sheet rows into the facts the agent writes about.\nconst since = $now.minus({ hours: 24 });\n\n// Calendar and sheet are written by people, so their text is data for the agent, not\n// instructions. Keep each field short and strip angle brackets so nothing can close the\n// <feiten> tag the prompt wraps it in.\nconst clip = (value, max) => {\n  if (value === undefined || value === null) return null;\n  const text = String(value).replace(/[<>]/g, '').trim();\n  if (!text) return null;\n  return text.length > max ? text.slice(0, max) + '…' : text;\n};\n\n// The Calendar API answers with one item holding all events in `items`.\nconst events = (node) =>\n  $(node).all().flatMap((item) => item.json.items ?? []).filter((e) => e.id && e.status !== 'cancelled');\n\nconst describe = (e) => {\n  const allDay = Boolean(e.start?.date);\n  return {\n    title: clip(e.summary, 120) || '(zonder titel)',\n    allDay,\n    start: allDay ? e.start.date : e.start?.dateTime,\n    // Google's all-day end date is exclusive; the agent gets the last day itself.\n    end: allDay ? DateTime.fromISO(e.end.date).minus({ days: 1 }).toISODate() : e.end?.dateTime,\n    location: clip(e.location, 120),\n    createdBy: clip(e.creator?.email, 80),\n  };\n};\n\nconst todayEvents = events('Today events').map(describe);\nconst changedEvents = events('Changed events').map((e) => ({\n  ...describe(e),\n  change: DateTime.fromISO(e.created) >= since ? 'nieuw' : 'gewijzigd',\n}));\n\nconst birthdays = $('Birthday sheet').all()\n  .map((item) => item.json)\n  .filter((r) => Number(r.birth_month) === $today.month && Number(r.birth_date) === $today.day)\n  .map((r) => {\n    const year = Number(r.birth_year);\n    return {\n      name: clip(r.name, 60),\n      age: year > 0 ? $today.year - year : null,\n      congrats_to: clip(r.congrats_to, 60),\n      custom_message: clip(r.custom_message, 300),\n    };\n  });\n\n// Botolas' memory: the last messages, kept in a second file of the gist so the\n// agent can avoid repeating greetings and jokes. A missing or broken file means no memory.\nconst HISTORY_FILE = 'botolas-history.json';\nlet recentMessages = [];\ntry {\n  const content = $('Recent messages').first().json.files?.[HISTORY_FILE]?.content;\n  const parsed = content ? JSON.parse(content) : [];\n  if (Array.isArray(parsed)) {\n    recentMessages = parsed\n      .filter((m) => m && typeof m.message === 'string' && m.date !== $today.toISODate())\n      .slice(-7);\n  }\n} catch (error) {\n  recentMessages = [];\n}\n\nreturn [{\n  json: {\n    facts: { today: $today.toISODate(), todayEvents, changedEvents, birthdays },\n    recentMessages,\n    historyFile: HISTORY_FILE,\n    hasNews: todayEvents.length + changedEvents.length + birthdays.length > 0,\n  },\n}];\n"
      }
    },
