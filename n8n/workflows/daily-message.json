        "text": "=<feiten>\n{{ JSON.stringify($json.facts, null, 2) }}\n</feiten>\n\n<eerdere_berichten>\n{{ $json.recentMessages.length ? $json.recentMessages.map((m) => '--- ' + m.date + ' ---\\n' + m.message).join('\\n\\n') : '(nog geen)' }}\n</eerdere_berichten>\n\nSchrijf nu het bericht van vandaag.",
        "options": {
