    {
      "id": "bdcd392d-161a-4157-a9a3-bef477698187",
      "name": "Facts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "// Turns the raw calendar events and sheet rows into the facts the agent writes about.\nconst since = $now.minus({ hours: 24 });\n\nconst events = (node) =>\n  $(node).all().map((item) => item.json).filter((e) => e.id && e.status !== 'cancelled');\n\nconst describe = (e) => {\n  const allDay = Boolean(e.start?.date);\n  return {\n    title: e.summary || '(zonder titel)',\n    allDay,\n    start: allDay ? e.start.date : e.start?.dateTime,\n    // Google's all-day end date is exclusive; the agent gets the last day itself.\n    end: allDay ? DateTime.fromISO(e.end.date).minus({ days: 1 }).toISODate() : e.end?.dateTime,\n    location: e.location || null,\n    createdBy: e.creator?.email || null,\n  };\n};\n\nconst todayEvents = events('Today events').map(describe);\nconst changedEvents = events('Changed events').map((e) => ({\n  ...describe(e),\n  change: DateTime.fromISO(e.created) >= since ? 'nieuw' : 'gewijzigd',\n}));\n\nconst birthdays = $('Birthday sheet').all()\n  .map((item) => item.json)\n  .filter((r) => Number(r.birth_month) === $today.month && Number(r.birth_date) === $today.day)\n  .map((r) => {\n    const year = Number(r.birth_year);\n    return {\n      name: r.name,\n      age: year > 0 ? $today.year - year : null,\n      congrats_to: r.congrats_to,\n      custom_message: String(r.custom_message ?? '').trim() || null,\n    };\n  });\n\nreturn [{\n  json: {\n    today: $today.toISODate(),\n    todayEvents,\n    changedEvents,\n    birthdays,\n    hasNews: todayEvents.length + changedEvents.length + birthdays.length > 0,\n  },\n}];\n"
      }
    },
